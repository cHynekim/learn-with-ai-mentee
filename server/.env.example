# ---------- 서버 ----------
# 로컬 개발은 아무 포트나, Docker 이미지 안에서는 3000 (docker run -p 80:3000)
PORT=3000
# 배포에서는 production. JWT_SECRET이 없거나 예시값이면 서버가 시작하지 않음
NODE_ENV=development
# 앞에 로드밸런서/리버스 프록시가 있을 때만 1 (EC2에 직접 노출이면 비워 둠)
TRUST_PROXY=

# ---------- DB ----------
# 로컬: docker compose 의 Postgres / 배포: RDS 엔드포인트
DATABASE_URL=postgres://mentee:mentee@localhost:5432/mentee
# RDS는 SSL 필수 → 배포에서 true
DB_SSL=false

# ---------- 인증 ----------
# 32자 이상 랜덤 값. 생성: openssl rand -hex 32
JWT_SECRET=change-me
# HTTPS일 때만 true. HTTP 배포에서 true면 로그인 쿠키가 저장되지 않음
COOKIE_SECURE=false
# 시연용 계정 바로 입장 버튼 (npm run seed 로 계정 생성 필요)
DEMO_MODE=true
# 소셜 로그인 콜백 주소 계산용 (소셜 로그인을 쓸 때만 필요)
CLIENT_URL=
SERVER_URL=http://localhost:3000

# ---------- AI (Baze / Mindlogic API Gateway, OpenAI 호환) ----------
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_API_KEY=your-baze-api-key
AI_MODEL=claude-sonnet-5-5

# LLM 요청 제한 (비워 두면 기본값: IP당 1분 30회 / 1시간 300회, 서버 전체 하루 3000회)
LLM_RATE_PER_MIN=
LLM_RATE_PER_HOUR=
LLM_DAILY_LIMIT=

# ---------- 간편로그인 (비워 두면 개발용 모의 로그인 화면으로 대체) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
