PORT=4000
DATABASE_URL=postgres://mentee:mentee@localhost:5432/mentee
# RDS 배포 시 true
PGSSL=false
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
DEMO_MODE=true

# Baze (Mindlogic) API Gateway - OpenAI 호환 chat completions
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_API_KEY=your-baze-api-key
AI_MODEL=claude-sonnet-5-5

# 간편로그인 (비워두면 개발용 모의 로그인 화면으로 대체)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
