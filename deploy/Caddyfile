# HTTPS 리버스 프록시 (Caddy가 Let's Encrypt 인증서를 자동 발급·갱신)
# 도메인을 바꾸면 아래 주소만 수정하면 됨

3-39-237-24.sslip.io {
	encode gzip
	# 같은 도커 네트워크의 앱 컨테이너(이름: baebae)로 전달
	reverse_proxy baebae:3000
}

# IP로 들어온 요청은 HTTPS 도메인으로 보냄 (http://3.39.237.24 → https://3-39-237-24.sslip.io)
http://3.39.237.24 {
	redir https://3-39-237-24.sslip.io{uri} permanent
}
